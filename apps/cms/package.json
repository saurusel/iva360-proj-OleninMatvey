{
  "name": "@iva360/cms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env CMS_ADMIN_ASSET_PREFIX=/admin NODE_OPTIONS=--no-deprecation NO_PROXY=localhost,127.0.0.1,::1 no_proxy=localhost,127.0.0.1,::1 next dev -p 3333 --hostname ::",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3333",
    "typecheck": "tsc --noEmit",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint . --config ../../eslint.config.mjs --max-warnings 0",
    "test": "tsx --test src/cms-rules.test.ts",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_CLI=true payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_CLI=true payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload"
  },
  "dependencies": {
    "@iva360/shared": "workspace:*",
    "@payloadcms/db-mongodb": "3.84.1",
    "@payloadcms/next": "3.84.1",
    "@payloadcms/richtext-lexical": "3.84.1",
    "@payloadcms/storage-s3": "3.84.1",
    "@payloadcms/translations": "3.84.1",
    "@payloadcms/ui": "3.84.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.3.1",
    "payload": "3.84.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.1",
    "typescript": "5.7.3"
  }
}
